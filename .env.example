# Copy to .env and adjust. Every value has a safe default; the app runs with an
# empty file (offline demo mode, deterministic local scoring, no API key).

# --- Web / session ---------------------------------------------------------
# Used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me

# SQLAlchemy database URL. Defaults to a local SQLite file.
DATABASE_URL=sqlite:///./interviewcoach.db

# --- LLM provider ----------------------------------------------------------
# Leave everything below empty to use the offline deterministic stub.
# Set ONE provider key to use a live model; LLM_PROVIDER is auto-detected from
# whichever key is present, or set it explicitly to: stub | anthropic | openai.
# LLM_PROVIDER=anthropic

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
